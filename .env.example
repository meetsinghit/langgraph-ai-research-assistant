# Copy this file to ".env" and fill in real values.
# .env is gitignored — NEVER commit real keys.

# LLM backend selection: gemini | openrouter | openai | ollama
LLM_PROVIDER=gemini

# Model name for the chosen backend (free-tier friendly default)
LLM_MODEL=gemini-2.5-flash

# Google Gemini free-tier API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter API key (optional): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI API key (optional)
OPENAI_API_KEY=

# Optional base-URL override (e.g. Ollama: http://localhost:11434/v1)
LLM_BASE_URL=

# Research-loop safety limits
MAX_RESEARCH_ITERATIONS=3
SEARCH_RESULTS_PER_QUERY=5
