# Copy this file to ".env" and fill in real values.
# .env is gitignored — NEVER commit real keys.

# LLM backend selection: gemini | openrouter | openai
# (openai is a PAID provider — also requires ALLOW_PAID_PROVIDERS=true)
LLM_PROVIDER=gemini

# Model name for the chosen backend (free-tier friendly default).
# Per-run overrides are picked from GET /api/models (the maintained
# free-tier registry, Phase 4E.3) — an explicit run model_id must be
# registry-selectable unless it names THIS default; runs never fall
# back to another model automatically. An explicit value here always
# overrides the built-in default.
LLM_MODEL=gemini-3.5-flash-lite

# Default reasoning depth for research: auto|minimal|low|medium|high
# (unset = medium). "auto" omits the parameter and lets the provider
# decide. Per-run overrides are capability-validated against the
# selected model's registry entry (4E.3 WS-B) — an unsupported level
# is rejected, never silently coerced. Verification always uses
# "low".
# LLM_THINKING_LEVEL=medium

# Model catalogue discovery (Phase 4E.3, WS-A): OFF by default, so
# nothing ever reaches the network during tests, launches or offline
# use. When enabled, GET /api/models annotates registry entries with
# live availability (TTL cache + backoff, single-flight, capped);
# discovery NEVER changes what is selectable — the registry does.
# MODEL_DISCOVERY_ENABLED=false
# MODEL_DISCOVERY_TTL_SECONDS=900
# MODEL_DISCOVERY_BACKOFF_SECONDS=300
# MODEL_DISCOVERY_TIMEOUT_SECONDS=10

# Google Gemini free-tier API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter API key: https://openrouter.ai/keys (free models available)
OPENROUTER_API_KEY=

# OpenAI API key (PAID — disabled unless ALLOW_PAID_PROVIDERS=true)
OPENAI_API_KEY=

# Explicitly enable paid providers (default: false)
ALLOW_PAID_PROVIDERS=false

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30

# Optional CA bundle (PEM) used to VERIFY server certificates when
# fetching pages — e.g. an enterprise TLS-inspection root that is
# not in certifi's store. Unset = OS trust store (truststore) or
# certifi. Verification is never disabled either way.
# SSL_CA_BUNDLE=C:/certs/enterprise-ca.pem

# Connection verification (opt-in smoke test via --verify-connection)
CONNECTION_VERIFY_SECONDS=30
CONNECTION_VERIFY_MAX_OUTPUT_TOKENS=256

# Research-loop safety limits
MAX_RESEARCH_ITERATIONS=3
MIN_FINDINGS=3
# Source pages that must be fetched/inspected before an answer
# counts as verified; search snippets never satisfy this (0 = off)
MIN_RETRIEVED_SOURCES=1
SEARCH_RESULTS_PER_QUERY=5

# Research depth budgets (Phase 4E.1): per-run overrides selected via
# --depth / research_depth. "standard" uses the historical settings
# above unchanged; quick and deep read these EXPLICIT knobs. Every
# value stays bounded by MAX_TOTAL_EXECUTION_SECONDS below — depth
# never extends the global deadline.
# Quick Answer (minimal sufficient retrieval, one research pass)
QUICK_MAX_PLAN_QUERIES=2
QUICK_MAX_RESEARCH_ITERATIONS=1
QUICK_MAX_TOOL_CALLS_PER_RESEARCH=3
QUICK_MIN_FINDINGS=2
QUICK_MIN_RETRIEVED_SOURCES=1
# Deep Research (broader planning, more passes, more independent
# retrieved sources — deliberately larger, deliberately visible)
DEEP_MAX_PLAN_QUERIES=6
DEEP_MAX_RESEARCH_ITERATIONS=5
DEEP_MAX_TOOL_CALLS_PER_RESEARCH=8
DEEP_MIN_FINDINGS=6
DEEP_MIN_RETRIEVED_SOURCES=3
# Per-source evidence cap for deep runs (still bounded to keep
# token usage predictable)
DEEP_MAX_EVIDENCE_CHARS=8000

# Separate execution limits
MAX_TOOL_CALLS_PER_RESEARCH=4
# Wall-clock budget PER RESEARCH PASS (each pass gets its own budget;
# the full run is bounded by MAX_RESEARCH_ITERATIONS x this value plus
# plan/synthesize/review LLM calls, which this does not cover).
MAX_EXECUTION_SECONDS=120
# GLOBAL end-to-end deadline for ONE run, separate from the per-pass
# budget above: stamped when the graph starts; every node, retry,
# backoff sleep and tool call consults this SAME budget, and owned
# request timeouts are capped by the time remaining. Cooperative by
# design: checked at operation boundaries, so an already-in-flight
# blocking call may over-run it by at most its own duration (a
# cancelled run is not claimed). On expiry the run returns a
# controlled TIMED_OUT result — sources gathered so far are
# preserved, no answer is synthesized after the deadline.
MAX_TOTAL_EXECUTION_SECONDS=180
# Provider retries AFTER the first attempt: applied only to failures
# classified retryable (429/quota, 5xx, timeout, transient network).
# Auth (bad key) and invalid-request errors are never retried;
# unrecognised errors are not retried blindly. SDK-level retries stay
# disabled at provider construction so the two layers never multiply.
# (0..6)
LLM_MAX_RETRIES=1
# Upper bound for ONE backoff sleep: exponential (base doubles per
# retry) with jitter; a provider Retry-After hint is honoured instead
# of the computed backoff but is still capped here. Every sleep is
# additionally clamped to the remaining global deadline.
RETRY_BACKOFF_MAX_SECONDS=30
MAX_REDIRECTS=5
MAX_PAGE_BYTES=1000000
MAX_PLAN_QUERIES=4
# Per-source evidence budget injected into model prompts: at most this
# many characters of a source's combined snippet+page text go into the
# research/synthesis prompts (truncated with an explicit marker beyond
# that). Keeps prompt size — and therefore input tokens — bounded no
# matter how large a fetched page is; full text stays in state for
# citation/provenance. (500.., default 6000)
MAX_EVIDENCE_CHARS=6000
# Per-RESULT cap on model-visible tool output: a fetched page is
# serialized into a transcript ToolMessage and re-sent on the next
# model invocation, so an oversized page would otherwise re-enter
# every later prompt (observed live: one 183K-char page = ~90% of a
# run's input tokens). Oversized payloads are reduced to
# query-relevant sections with an explicit marker; metrics still
# record the REAL result size. (500.., default 8000)
MAX_TOOL_RESULT_CHARS=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=research_agent.log
